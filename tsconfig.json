{
  "compilerOptions": {
    "lib": [
      "dom",
      "dom.iterable",
      "esnext"
    ],
    "allowJs": true,
    "target": "ES6",
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "react-jsx",
    "incremental": true,
    "plugins": [
      {
        "name": "next"
      }
    ],
    "paths": {
      "@/*": [
        "./*"
      ],
      "@ksum/romi-chat-core": [
        "./packages/romi-chat-core/src/index.tsx"
      ],
      "@ksum/romi-widget-rink": [
        "./packages/romi-widget-rink/src/index.tsx"
      ],
      "@ksum/romi-widget-technologies": [
        "./packages/romi-widget-technologies/src/index.tsx"
      ],
      "@ksum/romi-widget-instrumentation": [
        "./packages/romi-widget-instrumentation/src/index.tsx"
      ]
    }
  },
  "include": [
    "next-env.d.ts",
    "**/*.ts",
    "**/*.tsx",
    ".next/types/**/*.ts",
    ".next/dev/types/**/*.ts"
  ],
  "exclude": [
    "node_modules"
  ]
}